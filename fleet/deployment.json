{
 "_comment": "The single coworld-builder deployment. `agent` is filled in by fleet/bin/deploy.py from the coordinator id it created (create) or read from fleet/cloud.md (update). `environment_id` and `vault_ids` are read from fleet/cloud.md; the placeholders here are what deploy.py substitutes. `authorization_token` is NEVER stored in git \u2014 deploy.py re-supplies it from `gh auth token` at apply time, exactly as fleetctl.py does. The six starter repos are mounted read-only at /workspace/starters/<name>: phase 10 reads them to choose and cite a starter, and phase 20 clones the chosen one into the new repo's working tree for a clean history.",
 "name": "coworld-builder-hourly",
 "agent": {
  "type": "agent",
  "id": "<from cloud.md: coworld-builder-coordinator>",
  "version": 1
 },
 "environment_id": "<from cloud.md>",
 "vault_ids": [
  "<from cloud.md>"
 ],
 "schedule": {
  "type": "cron",
  "expression": "11 * * * *",
  "timezone": "UTC"
 },
 "resources": [
  {
   "type": "github_repository",
   "url": "https://github.com/Metta-AI/coworld-builder",
   "mount_path": "/workspace/coworld-builder",
   "authorization_token": "<resupply-at-apply>"
  },
  {
   "type": "github_repository",
   "url": "https://github.com/daveey/cogamer",
   "mount_path": "/workspace/cogamer",
   "authorization_token": "<resupply-at-apply>"
  },
  {
   "type": "github_repository",
   "url": "https://github.com/Metta-AI/cogame-babel",
   "mount_path": "/workspace/starters/cogame-babel",
   "authorization_token": "<resupply-at-apply>"
  },
  {
   "type": "github_repository",
   "url": "https://github.com/Metta-AI/cogame-bullwhip",
   "mount_path": "/workspace/starters/cogame-bullwhip",
   "authorization_token": "<resupply-at-apply>"
  },
  {
   "type": "github_repository",
   "url": "https://github.com/Metta-AI/cogame-parley",
   "mount_path": "/workspace/starters/cogame-parley",
   "authorization_token": "<resupply-at-apply>"
  },
  {
   "type": "github_repository",
   "url": "https://github.com/Metta-AI/coworld-ctf",
   "mount_path": "/workspace/starters/coworld-ctf",
   "authorization_token": "<resupply-at-apply>"
  },
  {
   "type": "github_repository",
   "url": "https://github.com/Metta-AI/cogame-moba",
   "mount_path": "/workspace/starters/cogame-moba",
   "authorization_token": "<resupply-at-apply>"
  },
  {
   "type": "github_repository",
   "url": "https://github.com/Metta-AI/cogame-factorio",
   "mount_path": "/workspace/starters/cogame-factorio",
   "authorization_token": "<resupply-at-apply>"
  }
 ],
 "initial_events": [
  {
   "type": "user.message",
   "content": [
    {
     "type": "text",
     "text": "Heartbeat. Read /workspace/coworld-builder/AGENT.md and run the heartbeat algorithm."
    }
   ]
  }
 ]
}
